from datetime import datetime

def analyze_orders(orders):
    monthly_data = {}

    for order in orders:
        date = datetime.strptime(order['date'], '%Y-%m-%d')
        year_month = date.strftime('%Y-%m')

        total_order_value = sum(item['price'] * item['quantity'] for item in order['items'])

        if year_month not in monthly_data:
            monthly_data[year_month] = {
                "total_value": 0,
                "order_count": 0
            }

        monthly_data[year_month]["total_value"] += total_order_value
        monthly_data[year_month]["order_count"] += 1

    result = {}
    for year_month, data in monthly_data.items():
        average_order_value = data["total_value"] / data["order_count"]
        result[year_month] = {
            "average_order_value": average_order_value,
            "order_count": data["order_count"]
        }

    return result

